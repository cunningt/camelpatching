From d8c4523bcc4dfbb522171438fab3d06e65b14819 Mon Sep 17 00:00:00 2001
From: Tom Cunningham <tcunning@redhat.com>
Date: Wed, 27 Aug 2025 15:06:12 -0400
Subject: [PATCH] Add dependency management entries for camel-version and azure
 to keep them aligned in PNC

---
 pom.xml | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/pom.xml b/pom.xml
index 029c2f12d..f58361dbf 100644
--- a/pom.xml
+++ b/pom.xml
@@ -81,6 +81,23 @@
         <version.com.microsoft.azure.azure-schemaregistry-kafka-avro>1.1.2</version.com.microsoft.azure.azure-schemaregistry-kafka-avro>
     </properties>
 
+    <dependencyManagement>
+        <dependencies>
+            <dependency>
+                <groupId>org.apache.camel</groupId>
+                <artifactId>camel-parent</artifactId>
+                <version>${camel-version}</version>
+            </dependency>
+
+            <dependency>
+                <groupId>com.azure</groupId>
+                <artifactId>azure-identity</artifactId>
+                <version>${version.com.azure.azure-identity}</version>
+            </dependency>
+
+        </dependencies>
+    </dependencyManagement>
+
     <developers>
         <developer>
             <name>The Apache Camel Team</name>
-- 
2.48.1

