From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Cunningham <tcunning@redhat.com>
Date: Sun, 30 Mar 2026 10:00:00 -0400
Subject: [PATCH] Add dependency management entries for camel version

---
diff --git a/pom.xml b/pom.xml
index 04395a2a7..11234b790 100644
--- a/pom.xml
+++ b/pom.xml
@@ -83,6 +83,23 @@
         <version.com.databricks.databricks-jdbc>3.0.7</version.com.databricks.databricks-jdbc>
     </properties>
 
+    <dependencyManagement>
+        <dependencies>
+            <dependency>
+                <groupId>org.apache.camel</groupId>
+                <artifactId>camel-parent</artifactId>
+                <version>${camel-version}</version>
+            </dependency>
+
+            <dependency>
+                <groupId>com.azure</groupId>
+                <artifactId>azure-identity</artifactId>
+                <version>${version.com.azure.azure-identity}</version>
+            </dependency>
+
+        </dependencies>
+    </dependencyManagement>
+
     <developers>
         <developer>
             <name>The Apache Camel Team</name>
