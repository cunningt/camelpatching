+                    // Ensure we are actually receiving what we are asking for
+                    if (exchanges == null || exchanges.isEmpty()) {
+                        return;
+                    }
+
+                    // The records from the batch are stored in a list of exchanges in the original exchange.
+                    int i = 0;
